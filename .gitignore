# ===== 密钥与运行时配置（绝不入库）=====
.ai-config.json
.pay-config.json
.pay-state.json
.pixelart-config.json

# ===== WorkBuddy 平台文件 =====
.wbapp_*.genie
.workbuddy/

# ===== 运行产物（生成链路输出的图纸样例等）=====
拼豆图纸-*.html
.pixelart-tasks/
.venv/

# ===== 生成单巡检快照（服务端每 30 分钟落盘，运行时产物）=====
.health/

# ===== 系统与依赖 =====
.DS_Store
node_modules/
*.log
.env
.env.*

# ===== Python =====
__pycache__/
.pixelart-tasks-vp/

# ===== 拼豆链路诊断采样（触发样本与追踪日志，不入库）=====
.pixelart-samples/
.pixelart-cleanup-trace.jsonl

# ===== 算法对比数据集（30 组生图对比原图+输出，372MB，不入库）=====
apps/pixelart/assert/生图对比/

# ===== 算法测试原图：图片体积大，本地保留即可；manifest.json（含 subject 判读）入仓库 =====
apps/pixelart/assert/算法测试原图/**/*.png
apps/pixelart/assert/算法测试原图/**/*.jpg
apps/pixelart/assert/算法测试原图/**/*.jpeg
apps/pixelart/assert/算法测试原图/**/*.webp
