# 点豆 — 雅加达机 Caddy 配置（dotbeads.online）
# ---------------------------------------------------------------
# 为什么不是「全站反代到本机」这么简单：
# 2026-10-31 起数据层自建，主库在广州（/opt/allmaster-data/dotbeads.db）。
# 雅加达只是「备案期对外入口」，如果它自己也跑一套库，就会出现两个平行世界：
# 用户在 dotbeads.online 注册，去 IP:8080 就看不到自己的账号和积分。
#
# 所以这里按路径分流：
#   静态页面 / 样式 / 脚本  → 本机 Node（雅加达本地出，快）
#   /api/*  与  /files/*    → 广州主库（登录、账本、订单、用户文件只有一份）
#
# 注意：跨境调用是这个方案的固有成本（雅加达→广州 RTT 约 80-120ms）。
#
# ★★★ 本文件是【临时设施】—— 备案通过后整段拆除 ★★★
# 决策日期 2026-10-31：数据库留在广州，dotbeads.online 在备案期靠反代连广州的库。
# 铁律：不要在反代这一层加任何功能（路由 / 缓存 / 限流 / 鉴权都不要），
#       所有能力在广州的应用里实现，否则拆反代时会被一起带走。
# 拆除步骤见 ARCHITECTURE.md「0.1 过渡架构：雅加达反代」。
# 拆除时 dotbeads.online 改 301 → 正式域名（发信域名不受影响，Resend 只看 DNS）。

dotbeads.online, www.dotbeads.online {
	encode zstd gzip

	# ① 业务接口与用户文件：唯一的真相在广州
	@backend path /api/* /files/*
	handle @backend {
		reverse_proxy 123.207.22.47:8080 {
			# ★ 必须把 Host 改写成 IP：腾讯云对「Host 里带未备案域名」的入站请求
			#   一律 302 到 dnspod.qcloud.com/static/webblock.html，8080 端口也拦。
			#   改成 IP 后放行（已实测：同机自测与公网访问均 200）。
			#   代价：广州侧看到 Host 是 IP，所以支付回调地址改用 PUBLIC_ORIGIN 环境变量。
			header_up Host 123.207.22.47:8080
			# 真实客户端 IP 靠 XFF 传过去（广州侧只信本机与雅加达这两个对端）
			header_up X-Forwarded-For {remote_host}
			# 图片生成单次 20~90s，SSE 心跳保活；超时放宽到 5 分钟
			transport http {
				read_timeout 300s
				write_timeout 300s
			}
			# 流式响应（SSE）不缓冲
			flush_interval -1
		}
	}

	# ② 页面与静态资源：本机出，走本地回环
	handle {
		reverse_proxy 127.0.0.1:8080 {
			transport http {
				read_timeout 300s
				write_timeout 300s
			}
			flush_interval -1
		}
	}

	# 安全响应头
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	log {
		output file /var/log/caddy/dotbeads.log {
			roll_size 20MiB
			roll_keep 5
		}
	}
}
